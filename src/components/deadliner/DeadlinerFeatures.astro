---
import { Image } from 'astro:assets'
import DeadlinerResponsive from './DeadlinerResponsive.astro'
import androidWidget from '../../assets/deadliner/widget-android.png'
import iosWidget from '../../assets/deadliner/widget-ios.png'
import harmonyWidget from '../../assets/deadliner/widget-harmony.png'
import syncVisual from '../../assets/deadliner/multi-device-sync.png'
import overviewScreenshot from '../../assets/deadliner/overview-light-anonymized.png'
import quickAddScreenshot from '../../assets/deadliner/quick-add.png'
import lifiHabitPhone from '../../assets/deadliner/lifi-habit-phone.png'
const widgetScreens = [
  {
    platform: 'Android',
    src: androidWidget,
    width: 868,
    height: 1813,
    cropTop: 0,
    visibleHeight: 1813,
    tone: 'blue',
  },
  {
    platform: 'iOS',
    src: iosWidget,
    width: 877,
    height: 1792,
    cropTop: 14,
    visibleHeight: 1766,
    tone: 'purple',
  },
  {
    platform: 'HarmonyOS',
    src: harmonyWidget,
    width: 873,
    height: 1802,
    cropTop: 0,
    visibleHeight: 1802,
    tone: 'mint',
  },
]
---

<section class="features" id="experience">
  <div class="feature-wrap">
    <header class="section-title">
      <p class="eyebrow">日常任务管理</p><h2>想到就记。<br />做完就划。</h2><p>
        快速添加、滑动操作、概览统计。每天要用的，都顺手。
      </p>
    </header>
    <div class="task-showcase" aria-label="任务管理功能展示">
      <article class="task-detail">
        <div
          class="demo quick-demo feature-demo"
          data-feature-demo
          role="button"
          tabindex="0"
          aria-pressed="false"
          aria-label="快速添加：切换实际界面"
        >
          <div class="demo-sample">
            <span class="demo-caption">快速添加</span><div class="input-line">
              周五前交设计初稿<span class="cursor"></span>
            </div><div class="input-options">
              <span>周五</span><span>工作</span><span class="add-button">＋</span>
            </div>
          </div>
          <div class="demo-real" aria-hidden="true">
            <template data-real-media>
              <Image
                class="quick-photo"
                src={quickAddScreenshot}
                alt="快速添加任务，AI 解析完成后的确认提示"
                widths={[400, 640, 1170]}
                sizes="(max-width: 650px) 420px, 28vw"
                format="webp"
                loading="lazy"
                decoding="async"
              />
            </template>
          </div>
        </div><h3>先记下，再安排。</h3><p>
          填上任务，选好日期和分类。<br />给脑子腾点地方。
        </p>
      </article>
      <article class="task-detail">
        <div
          class="demo swipe-demo feature-demo"
          data-feature-demo
          role="button"
          tabindex="0"
          aria-pressed="false"
          aria-label="滑动交互：切换实际界面"
        >
          <div class="demo-sample">
            <span class="demo-caption">滑动交互</span><div class="swipe-track">
              <span class="swipe-action">✓</span><div
                class="swipe-task"
                style="--progress:72%;--task-fill:#a7c8f2;--task-rest:#e9f0fa"
              >
                <b>整理本周计划</b><small>3天</small>
              </div>
            </div><div class="swipe-track delete-track">
              <div
                class="swipe-task"
                style="--progress:24%;--task-fill:#f2c796;--task-rest:#fcf0e1"
              >
                <b>准备分享</b><small>今天</small>
              </div><span class="swipe-action">×</span>
            </div>
          </div>
          <div class="demo-real" aria-hidden="true">
            <template data-real-media>
              <video
                class="swipe-video"
                data-swipe-video
                src="/res/deadliner/swipe-demo.mp4"
                poster="/res/deadliner/swipe-demo-poster.jpg"
                width="960"
                height="534"
                muted
                loop
                playsinline
                preload="none"
                aria-label="Deadliner 任务列表滑动操作演示"
              >
                你的浏览器暂不支持视频播放。
              </video>
            </template>
          </div>
        </div><h3>划一下，搞定。</h3><p>
          完成和删除，顺手一划。<br />常用操作，不用翻菜单。
        </p>
      </article>
      <article class="task-detail">
        <div
          class="demo stats-demo feature-demo"
          data-feature-demo
          role="button"
          tabindex="0"
          aria-pressed="false"
          aria-label="概览统计：切换实际界面"
        >
          <div class="demo-sample">
            <span class="demo-caption">概览统计</span><div class="stats-top">
              <b>本周完成<em>12<span>项</span></em></b><div class="ring">
                <span>75<small>%</small></span>
              </div>
            </div><div class="bars">
              {
                [35, 55, 42, 78, 62, 95, 72].map((height) => (
                  <i style={`--bar:${height}%`} />
                ))
              }
            </div>
          </div>
          <div class="demo-real" aria-hidden="true">
            <template data-real-media>
              <div class="overview-crop">
                <Image
                  class="overview-photo"
                  src={overviewScreenshot}
                  alt="Deadliner 月度洞察与完成统计，内容为示例数据"
                  widths={[400, 640, 1006]}
                  sizes="(max-width: 650px) 320px, 28vw"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </template>
          </div>
        </div><h3>忙没白忙。</h3><p>完成多少，进度如何。<br />打开概览，心里有数。</p>
      </article>
    </div>
    <p class="placeholder">
      <span class="hover-hint">悬停查看实际界面</span><span class="touch-hint"
        >点击查看实际界面</span
      > · 概览使用示例数据
    </p>
  </div>
</section>

<section class="lifi-section" id="agent">
  <div class="feature-wrap lifi-layout">
    <div class="lifi-copy">
      <p class="eyebrow">Lifi AI · 任务管理 Agent</p><h2>
        说说你的计划。<br /><span>剩下的，一起理。</span>
      </h2><p class="lead">
        从一句想法，到一件待办。<br />Lifi 帮你把话聊明白，把事情安排好。
      </p><div class="lifi-capabilities">
        <article>
          <h3>添加任务与习惯</h3><p>“周五交稿，每晚读书。”说出来，让 Lifi 帮你记。</p>
        </article><article>
          <h3>智能对话</h3><p>聊计划，也聊怎么做。把下一步想清楚。</p>
        </article><article>
          <h3>记忆</h3><p>记住你的偏好，让下次对话少些重复。</p>
        </article>
      </div>
    </div>
    <div class="conversation-stage">
      <div class="conversation" aria-label="Lifi 对话界面示意">
        <div class="conversation-heading">
          <span class="lifi-orb"></span><b>Lifi</b><span>＋</span>
        </div><div class="message user-message">
          帮我记一下周五交设计初稿，再加个每天读书 20 分钟的习惯。
        </div><div class="message ai-message">好，把这两件事安排上。</div><div
          class="suggestion"
        >
          <span class="suggestion-icon">✓</span><div>
            <small>任务</small><b>提交设计初稿</b><span>周五 · 工作</span>
          </div>
        </div><div class="suggestion">
          <span class="suggestion-icon">↻</span><div>
            <small>习惯</small><b>阅读 20 分钟</b><span>每天</span>
          </div>
        </div><div class="memory-note"><span>✧</span> 记忆示意：你喜欢在晚上阅读</div><div
          class="conversation-input"
        >
          聊聊接下来的安排<span>↑</span>
        </div>
      </div>
      <Image
        class="lifi-phone"
        src={lifiHabitPhone}
        alt="Lifi 添加任务与阅读习惯的流程示意，习惯部分经编辑"
        widths={[320, 480, 720]}
        sizes="(max-width:650px) 180px, 245px"
        format="webp"
        loading="lazy"
        decoding="async"
      />
      <p class="lifi-preview-note">对话与习惯流程示意 · 非实际运行记录</p>
    </div>
  </div>
</section>

<section class="widgets-section" id="widgets">
  <div class="feature-wrap">
    <header class="section-title centered">
      <p class="eyebrow">把任务放在桌面</p><h2>不用打开，也能惦记上。</h2><p>
        三端都有小组件。待办和习惯，抬眼就看见。
      </p>
    </header>
    <div class="widget-gallery">
      {
        widgetScreens.map((screen, index) => (
          <figure
            class={`widget-scene tone-${screen.tone}`}
            data-widget-reveal
            style={`--reveal-delay:${index * 130}ms`}
          >
            <div class="widget-device">
              <div
                class="widget-crop"
                style={`--device-ratio:${screen.width}/${screen.visibleHeight};--image-height:${(screen.height / screen.visibleHeight) * 100}%;--image-top:${(-screen.cropTop / screen.visibleHeight) * 100}%`}
              >
                <Image
                  class="widget-photo"
                  widths={[320, 480, 640, 880]}
                  sizes="(max-width: 650px) 220px, (max-width: 1000px) 22vw, 230px"
                  format="webp"
                  src={screen.src}
                  alt={`${screen.platform} 桌面上的 Deadliner 小组件`}
                  loading="lazy"
                  decoding="async"
                  width={screen.width}
                  height={screen.height}
                />
              </div>
            </div>
            <figcaption>{screen.platform}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<section class="sync-section" id="privacy">
  <div class="feature-wrap">
    <header class="section-title centered">
      <p class="eyebrow">多端同步</p><h2>换个设备<br /><span>接着做</span></h2><p>
        用自己的云盘，或熟悉的平台云服务。
      </p>
    </header>
    <figure class="sync-visual">
      <Image
        src={syncVisual}
        widths={[640, 960, 1280, 1672]}
        sizes="(max-width: 650px) 100vw, (max-width: 1180px) calc(100vw - 72px), 1108px"
        format="webp"
        alt="金属同步环与玻璃任务面板，呈现多端任务同步"
        width="1672"
        height="941"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="sync-options">
      <article>
        <h3>WebDAV</h3><span>跨平台</span><p>
          连接支持 WebDAV 的云盘，在不同平台间同步任务。
        </p>
      </article><article>
        <h3>华为云同步</h3><span>HarmonyOS</span><p>
          使用华为账号云空间，衔接鸿蒙设备上的安排。
        </p>
      </article><article>
        <h3>iCloud</h3><span>iOS</span><p>使用自己的 iCloud，在苹果设备间接续任务。</p>
      </article>
    </div><p class="sync-note">
      跨平台同步请选择 WebDAV；平台云服务用于对应生态，支持情况以各端版本与设置为准。
    </p>
  </div>
</section>

<DeadlinerResponsive />

<script>
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)')
  function setupFeatureDemos() {
    document.querySelectorAll<HTMLElement>('[data-feature-demo]').forEach((demo) => {
      if (demo.dataset.bound) return
      demo.dataset.bound = 'true'
      const setReal = (show: boolean) => {
        if (show) {
          const template = demo.querySelector<HTMLTemplateElement>('[data-real-media]')
          template?.replaceWith(template.content.cloneNode(true))
        }
        demo.classList.toggle('is-real', show)
        demo.setAttribute('aria-pressed', String(show))
        demo.querySelector('.demo-sample')?.setAttribute('aria-hidden', String(show))
        demo.querySelector('.demo-real')?.setAttribute('aria-hidden', String(!show))
        setupSwipeVideo()
      }
      demo.addEventListener('mouseenter', () => {
        if (finePointer.matches) setReal(true)
      })
      demo.addEventListener('mouseleave', () => {
        if (finePointer.matches) setReal(false)
      })
      demo.addEventListener('click', (event) => {
        if (
          finePointer.matches ||
          (event.target instanceof HTMLVideoElement && event.target.controls)
        )
          return
        setReal(!demo.classList.contains('is-real'))
      })
      demo.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault()
          setReal(!demo.classList.contains('is-real'))
        } else if (event.key === 'Escape') setReal(false)
      })
      demo.addEventListener('blur', () => setReal(false))
    })
  }
  let videoObserver: IntersectionObserver | undefined
  function setupSwipeVideo() {
    videoObserver?.disconnect()
    const videos = document.querySelectorAll<HTMLVideoElement>('[data-swipe-video]')
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    videos.forEach((video) => {
      video.muted = true
      video.controls = reduceMotion
      video.pause()
    })
    if (reduceMotion) return
    videoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement
          if (
            entry.isIntersecting &&
            !document.hidden &&
            video.closest('[data-feature-demo]')?.classList.contains('is-real')
          ) {
            video
              .play()
              .then(() => {
                video.controls = false
              })
              .catch(() => {
                video.controls = true
              })
          } else video.pause()
        })
      },
      { threshold: 0.3 },
    )
    videos.forEach((video) => videoObserver?.observe(video))
  }
  setupFeatureDemos()
  setupSwipeVideo()
  document.addEventListener('astro:page-load', setupFeatureDemos)
  document.addEventListener('astro:page-load', setupSwipeVideo)
  document.addEventListener('astro:before-swap', () => videoObserver?.disconnect())
  document.addEventListener('visibilitychange', setupSwipeVideo)
  window
    .matchMedia('(prefers-reduced-motion: reduce)')
    .addEventListener('change', setupSwipeVideo)
  let widgetObserver: IntersectionObserver | undefined
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
  function revealWidgets() {
    widgetObserver?.disconnect()
    const figures = document.querySelectorAll<HTMLElement>('[data-widget-reveal]')
    if (reducedMotion.matches || !('IntersectionObserver' in window)) {
      figures.forEach((figure) => figure.classList.remove('reveal-ready'))
      return
    }
    widgetObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach(async (entry) => {
          if (!entry.isIntersecting) return
          const figure = entry.target as HTMLElement
          observer.unobserve(figure)
          figure.dataset.revealed = 'true'
          const photo = figure.querySelector('img')
          if (photo) await photo.decode().catch(() => {})
          figure.classList.add('is-visible')
        })
      },
      { threshold: 0.15, rootMargin: '0px 0px -32px 0px' },
    )
    figures.forEach((figure) => {
      if (figure.dataset.revealed) return
      figure.classList.add('reveal-ready')
      widgetObserver?.observe(figure)
    })
  }
  revealWidgets()
  document.addEventListener('astro:page-load', revealWidgets)
  reducedMotion.addEventListener('change', revealWidgets)
</script>

<style>
  .features {
    background: #e3e8ef;
  }
  .widgets-section {
    background: #f5f5f7;
  }
  .feature-wrap {
    max-width: 1180px;
    margin: auto;
    padding: 110px 36px;
  }
  .section-title {
    max-width: 760px;
    margin-bottom: 60px;
  }
  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    color: #6e6e73;
    margin: 0 0 20px;
    letter-spacing: 0.035em;
  }
  h2 {
    font-size: clamp(34px, 4.5vw, 60px);
    font-weight: 620;
    letter-spacing: -0.045em;
    line-height: 1.15;
    margin: 0;
  }
  h2 span {
    color: #6e6e73;
  }
  .section-title > p:last-child,
  .lead {
    color: #6e6e73;
    font-size: 17px;
    line-height: 1.7;
    margin: 22px 0 0;
  }
  .centered {
    margin-inline: auto;
    text-align: center;
  }
  .task-showcase {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px;
  }
  .task-detail h3 {
    font-size: 23px;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin: 28px 0 12px;
  }
  .task-detail p {
    font-size: 14px;
    line-height: 1.8;
    color: #6e6e73;
    margin: 0;
  }
  .demo {
    height: 230px;
    background: #fff;
    border-radius: 20px;
    padding: 25px;
    overflow: hidden;
    box-shadow: 0 10px 30px #1d1d1f05;
  }
  .demo-caption {
    display: block;
    color: #86868b;
    font-size: 11px;
    margin-bottom: 28px;
  }
  .input-line {
    font-size: 17px;
    font-weight: 550;
    white-space: nowrap;
  }
  .cursor {
    display: inline-block;
    width: 2px;
    height: 21px;
    margin-left: 4px;
    background: #1976d2;
    vertical-align: middle;
  }
  .input-options {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 35px;
    font-size: 12px;
    color: #6e6e73;
  }
  .input-options > span {
    padding: 8px 12px;
    border-radius: 9px;
    background: #f5f5f7;
  }
  .input-options .add-button {
    background: #1976d2;
    color: white;
    font-size: 22px;
    padding: 1px 11px;
    margin-left: auto;
  }
  .swipe-track {
    display: flex;
    align-items: center;
    height: 49px;
    background: #3ca879;
    border-radius: 12px;
    margin-bottom: 12px;
    overflow: hidden;
  }
  .swipe-action {
    color: #fff;
    padding: 0 19px;
    font-size: 20px;
  }
  .swipe-task {
    display: flex;
    align-items: center;
    gap: 9px;
    white-space: nowrap;
    background: linear-gradient(
      to right,
      var(--task-fill) 0 var(--progress),
      var(--task-rest) var(--progress) 100%
    );
    justify-content: space-between;
    height: 100%;
    padding: 0 14px;
    border-radius: 10px;
    font-size: 12px;
    flex: 1;
  }
  .swipe-task b {
    font-weight: 550;
  }
  .swipe-task small {
    font-size: 10px;
    color: #536174;
  }
  .delete-track {
    background: #e26464;
  }
  .demo.feature-demo {
    position: relative;
    padding: 0;
    cursor: pointer;
    background: #fff;
  }
  .feature-demo:focus-visible {
    outline: 3px solid #1976d2;
    outline-offset: 5px;
  }
  .demo-sample,
  .demo-real {
    position: absolute;
    inset: 0;
    transition: opacity 0.25s ease;
  }
  .demo-sample {
    padding: 25px;
  }
  .demo-real {
    opacity: 0;
    visibility: hidden;
  }
  .is-real .demo-sample {
    opacity: 0;
    visibility: hidden;
  }
  .is-real .demo-real {
    opacity: 1;
    visibility: visible;
  }
  .touch-hint {
    display: none;
  }
  @media (hover: none), (pointer: coarse) {
    .hover-hint {
      display: none;
    }
    .touch-hint {
      display: inline;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-sample,
    .demo-real {
      transition: none;
    }
  }
  .stats-demo .demo-caption {
    margin-bottom: 15px;
  }
  .stats-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .stats-top > b {
    font-size: 11px;
    font-weight: 500;
    color: #6e6e73;
  }
  .stats-top em {
    display: block;
    font-size: 35px;
    font-style: normal;
    letter-spacing: -0.04em;
    color: #1d1d1f;
    margin-top: 5px;
  }
  .stats-top em span {
    font-size: 11px;
    margin-left: 6px;
    color: #6e6e73;
  }
  .ring {
    width: 69px;
    height: 69px;
    border-radius: 50%;
    background: conic-gradient(#1976d2 75%, #eaf0f5 0);
    display: grid;
    place-items: center;
  }
  .ring > span {
    display: grid;
    place-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: white;
    font-size: 17px;
  }
  .ring small {
    font-size: 9px;
  }
  .bars {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 12px;
    height: 48px;
    margin-top: 20px;
  }
  .bars i {
    width: 17px;
    height: var(--bar);
    background: #a7cae9;
    border-radius: 4px 4px 0 0;
  }
  .bars i:last-child {
    background: #1976d2;
  }
  .demo.quick-demo {
    padding: 0;
  }
  .quick-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 65%;
  }
  .demo.swipe-demo {
    padding: 0;
  }
  .swipe-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .demo.stats-demo {
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .overview-crop {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: inherit;
  }
  .overview-photo {
    position: absolute;
    left: 0;
    top: 0;
    transform: translateY(-19.8%);
    width: 100%;
    height: auto;
  }

  .placeholder {
    font-size: 10px;
    color: #96969b;
    text-align: center;
    margin: 32px 0 0;
  }
