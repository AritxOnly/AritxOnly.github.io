]

// Tiny shell / JSON highlighter for the illustrative terminals (build time only).
const escapeHtml = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
const token = (kind: string, text: string) => `<span class="t-${kind}">${escapeHtml(text)}</span>`

function highlightJson(line: string) {
  const pattern = /("(?:[^"\\]|\\.)*")(\s*:)?|\b(true|false|null)\b|(-?\d+(?:\.\d+)?)|([{}\[\],:]|…)/g
  let html = ''
  let last = 0
  for (const match of line.matchAll(pattern)) {
    html += escapeHtml(line.slice(last, match.index))
    const [whole, str, colon, keyword, number, punct] = match
    if (str && colon) html += token('key', str) + token('punct', colon)
    else if (str) html += token('str', str)
    else if (keyword) html += token('bool', keyword)
    else if (number) html += token('num', number)
    else if (punct) html += token('punct', punct)
    last = (match.index ?? 0) + whole.length
  }
  return html + escapeHtml(line.slice(last))
}

function highlightShell(line: string) {
  if (!line) return ''
  if (line.startsWith('#')) return token('comment', line)
  if (line.startsWith('{')) return highlightJson(line)
  const parts = line.match(/"[^"]*"|\s+|\S+/g) ?? []
  let seenCommand = false
  const body = parts
    .map((part) => {
      if (/^\s+$/.test(part)) return part
      if (!seenCommand) {
        seenCommand = true
        return token('cmd', part)
      }
      if (part.startsWith('--')) return token('flag', part)
      if (part.startsWith('"')) return token('str', part)
      if (/^<.+>$/.test(part)) return token('ph', part)
      if (/^[\d][\d:T+\-.]*$/.test(part)) return token('num', part)
      return token('sub', part)
    })
    .join('')
  return `${token('prompt', '$')} ${body}`
}
const terminal = (lines: string[]) => lines.map(highlightShell).join('\n')

const heroTerminal = terminal([
  'deadliner task add --title "提交周报"',
  'deadliner task list',
  'deadliner task complete <ID>',
  '',
  '# Agent 显式要求 JSON',
  'deadliner --json task list --limit 20',
  '{"ok":true,"version":1,"data":{"items":[…],"total":1}}',
])

const panelTerminal = terminal([
  'deadliner task add --title "提交周报" --due 2026-11-11T18:00:00+08:00',
  'deadliner task complete <ID>',
  '',
  '# Agent：只看 ok 与退出码',
  'deadliner --json task get <ID>',
  '{"ok":false,"version":1,"error":{"code":"NOT_FOUND","message":"Task not found"}}',
  '# exit 3 · 0 成功 · 2 参数 · 4 冲突 · 5 同步失败',
])
