---
import { Image } from 'astro:assets'
import heroDevices from '../../../public/res/deadliner/hero-devices.png'
import DeadlinerHelloEffect from './DeadlinerHelloEffect'
---

<!-- Lettering drawn as centerline SVG strokes. Timing, round caps and stroke weight
     follow the Apple Hello Effect reference at chanhdai.com/components/apple-hello-effect. -->
<script is:inline>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('deadliner-intro')
    window.setTimeout(() => {
      document.documentElement.classList.remove('deadliner-intro')
      document.documentElement.classList.add('deadliner-entered')
    }, 10000)
  }
</script>
<section class="deadliner-hero" id="top" aria-labelledby="hero-title">
  <div class="product-stage">
    <div class="deadliner-welcome" aria-hidden="true">
      <DeadlinerHelloEffect client:load />
    </div>

    <div class="hero-devices product-rise" style="--enter-delay: .08s">
      <Image
        class="hero-composite"
        src={heroDevices}
        alt="Deadliner 在手机、平板与手表上的任务、灵感、AI 对话和概览界面"
        widths={[768, 1280, 1920, 2560, 3840]}
        sizes="100vw"
        format="webp"
        quality={95}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
  <div class="product-bottom">
    <div class="product-copy product-rise" style="--enter-delay:.12s">
      <p class="product-name">
        <span>Deadliner</span><span class="product-kind">待办日历</span>
      </p>
      <h1 id="hero-title">重塑任务管理体验</h1>
      <p class="product-slogan">让任务可感，让进度可见</p>
    </div>
    <div class="product-action product-rise" style="--enter-delay:.24s">
      <span class="product-platforms" aria-label="支持 Android、iOS 与 HarmonyOS">
        <span class="platform-mark"
          ><Image
            class="android-mark"
            src="/res/deadliner/android-logo.svg"
            width={280}
            height={155}
            loading="eager"
            decoding="async"
            alt="Android"
          /></span
        >
        <span class="platform-mark"
          ><Image
            class="apple-mark"
            src="/res/deadliner/apple-logo.svg"
            width={1300}
            height={1781}
            loading="eager"
            decoding="async"
            alt="iOS"
          /></span
        >
        <span class="platform-mark"
          ><Image
            class="harmony-mark"
            src="/res/deadliner/harmony-o.svg"
            width={10}
            height={13}
            loading="eager"
            decoding="async"
            alt="HarmonyOS"
          /></span
        >
      </span>
      <a href="#download" class="product-download">下载</a>
    </div>
  </div>
</section>

<style>
  .deadliner-welcome {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    place-items: center;
    opacity: 0.86;
    pointer-events: none;
    transition: opacity 1s ease;
  }
  :global(html.deadliner-intro) {
    overflow: hidden;
    background: #000;
  }
  :global(.deadliner-intro body) {
    background: #000;
  }
  :global(.deadliner-intro) .deadliner-welcome {
    z-index: 2;
    opacity: 1;
  }
  .deadliner-welcome :global(svg) {
    display: block;
    width: 88vw;
    max-width: 1800px;
    height: auto;
    overflow: visible;
    transform: translateY(0);
    transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.deadliner-intro) .deadliner-welcome :global(svg) {
    transform: translateY(var(--welcome-offset-y, 0px));
  }
  .deadliner-hero {
    min-height: calc(100svh - 64px);
    display: flex;
    flex-direction: column;
    padding: 0 clamp(24px, 3.85vw, 100px) 30px;
    overflow: hidden;
    background: #000;
    color: #f5f5f7;
  }
  .product-stage {
    position: relative;
    flex: 1;
    min-height: 360px;
    height: 60svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    margin-inline: calc(-1 * clamp(24px, 3.85vw, 100px));
    padding: 30px 0 24px;
  }
  .hero-devices {
    position: relative;
    z-index: 1;
    width: 100%;
    min-width: 0;
    margin: 0 auto;
  }
  .hero-composite {
    display: block;
    width: 100%;
    height: auto;
  }
  .product-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding-top: 16px;
  }
  .product-name {
    display: flex;
    align-items: baseline;
    gap: 9px;
    margin: 0 0 12px;
    font-size: clamp(17px, 1.35vw, 22px);
    line-height: 1.4;
    font-weight: 550;
    letter-spacing: -0.01em;
  }
  .product-kind {
    color: #b3b3b8;
    font-weight: 450;
    letter-spacing: 0.02em;
  }
  .product-copy h1 {
    margin: 0;
    font-size: clamp(32px, 3.2vw, 56px);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .product-slogan {
    margin: 16px 0 0;
    font-size: clamp(13px, 1.05vw, 16px);
    line-height: 1.6;
    letter-spacing: 0.035em;
    color: #a1a1a6;
  }
  .product-action {
    display: flex;
    align-items: center;
    gap: 26px;
    padding: 10px 10px 10px 26px;
    border-radius: 999px;
    background: #232325;
    flex-shrink: 0;
  }
  .product-platforms {
    --platform-mark-size: 26px;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .platform-mark {
    display: grid;
    place-items: center;
    width: var(--platform-mark-size);
    height: var(--platform-mark-size);
    flex: none;
  }
  .product-platforms img {
    display: block;
    width: var(--platform-mark-size);
    height: var(--platform-mark-size);
    object-fit: contain;
    filter: grayscale(1) brightness(0) invert(1);
    opacity: 0.87;
  }
  .product-platforms .android-mark {
    transform: scale(0.92);
  }
  .product-platforms .apple-mark {
    transform: scale(1.29);
  }
  .product-platforms .harmony-mark {
    transform: scale(0.96);
  }
  .product-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 26px;
    border-radius: 999px;
    background: #0071e3;
    color: white !important;
    font-size: 17px;
    transition: background 0.2s;
  }
  .product-download:hover {
    background: #0077ed;
  }
  :global(.deadliner-intro) .product-rise {
    opacity: 0;
    transform: translateY(110px);
  }
  :global(.deadliner-entered) .product-rise {
    animation: product-arrive 1.05s cubic-bezier(0.16, 1, 0.3, 1) var(--enter-delay, 0s)
      both;
  }
  :global(.deadliner-intro .nav) {
    opacity: 0;
    transform: translateY(30px);
  }
  :global(.deadliner-entered .nav) {
    animation: product-arrive 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both;
  }
  @keyframes product-arrive {
    from {
      opacity: 0;
      transform: translateY(110px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (min-width: 1800px) {
    .product-stage {
      position: relative;
      min-height: 600px;
    }
  }
  @media (max-width: 900px) {
    .product-bottom {
      gap: 20px;
    }
    .product-copy h1 {
      font-size: clamp(28px, 3.8vw, 36px);
    }
    .product-name {
      font-size: 16px;
    }
    .product-action {
      gap: 18px;
      padding-left: 18px;
    }
    .product-platforms {
      gap: 12px;
    }
    .product-download {
      padding-inline: 22px;
      font-size: 15px;
    }
  }
  @media (max-width: 650px) {
    .deadliner-hero {
      padding: 0 24px 34px;
      min-height: calc(100svh - 64px);
    }
    .product-stage {
      position: relative;
      height: 50svh;
      min-height: 320px;
      padding-top: 20px;
      margin-inline: -24px;
    }
    .product-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 22px;
    }
    .product-name {
      font-size: 15px;
      gap: 7px;
      margin-bottom: 11px;
    }
    .product-copy h1 {
      font-size: clamp(26px, 7vw, 32px);
    }
    .product-slogan {
      margin-top: 13px;
      font-size: 13px;
    }
    .product-action {
      padding: 6px 6px 6px 17px;
      gap: 24px;
    }
    .product-platforms {
      --platform-mark-size: 22px;
    }
    .product-download {
      min-height: 39px;
      font-size: 14px;
      padding: 0 22px;
    }
    .deadliner-welcome :global(svg) {
      width: 91vw;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .deadliner-welcome,
    .deadliner-welcome :global(svg) {
      transition: none;
    }
    :global(.deadliner-entered) .product-rise,
    :global(.deadliner-entered .nav) {
      animation: none;
    }
    .product-download {
      transition: none;
    }
  }
</style>
