---
import IconGithub from '~/icons/github.svg'
import IconBilibili from '~/icons/bilibili.svg'
import IconXiaohongshu from '~/icons/xiaohongshu.svg'
import IconEmail from '~/icons/email.svg'
import IconTwitter from '~/icons/twitter.svg'
import IconNetease from '~/icons/netease.svg'
import IconSoundcloud from '~/icons/soundcloud.svg'
import IconRss from '~/icons/rss.svg'
const icons = {
  github: IconGithub,
  bilibili: IconBilibili,
  xiaohongshu: IconXiaohongshu,
  email: IconEmail,
  twitter: IconTwitter,
  netease: IconNetease,
  soundcloud: IconSoundcloud,
}

interface Props {
  friend: {
    name: string
    site?: string
    avatar?: string
    bio?: string
    tags?: string[]
    rss?: string | null
    social?: Record<string, string | boolean | undefined>
    note?: string
    reciprocal?: boolean
  }
}
const { friend } = Astro.props
const labels: Record<string, string> = {
  github: 'GitHub',
  bilibili: 'Bilibili',
  xiaohongshu: '小红书',
  email: '邮件',
  twitter: 'X',
  netease: '网易云',
  soundcloud: 'SoundCloud',
}
const links = Object.entries(friend.social ?? {}).filter(
  (entry): entry is [string, string] => typeof entry[1] === 'string',
)
---

<article class="friend-card">
  <div class="friend-top">
    <div class="friend-avatar">
      <span aria-hidden="true">{friend.name.slice(0, 1)}</span>{
        friend.avatar && (
          <img
            src={friend.avatar}
            alt={`${friend.name}的头像`}
            width="64"
            height="64"
            loading="lazy"
            data-friend-avatar
          />
        )
      }
    </div><div>
      <h2>
        {
          friend.site ? (
            <a href={friend.site} target="_blank" rel="noopener noreferrer">
              {friend.name} ↗
            </a>
          ) : (
            friend.name
          )
        }
      </h2>{
        friend.note && (
          <p class="friend-note">{friend.note === 'Friend' ? '好朋友' : friend.note}</p>
        )
      }
    </div>
  </div>
  <p class="friend-bio">{friend.bio || '见字如面，常来常往。'}</p>
  <div class="friend-tags">
    {friend.tags?.map((tag) => <span>{tag}</span>)}{
      friend.reciprocal && <span>已互链</span>
    }
  </div>
  <div class="friend-links">
    {
      friend.site && (
        <a
          class="friend-visit"
          href={friend.site}
          target="_blank"
          rel="noopener noreferrer"
        >
          去串门 <span aria-hidden="true">↗</span>
        </a>
      )
    }
    <div class="friend-socials">
      {
        friend.rss && (
          <a
            href={friend.rss}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`订阅 ${friend.name} 的 RSS`}
            title="RSS 订阅"
          >
            <IconRss aria-hidden="true" />
          </a>
        )
      }
      {
        links.map(([key, url]) => {
          const Icon = icons[key as keyof typeof icons]
          return (
            <a
              href={key === 'email' && !url.startsWith('mailto:') ? 'mailto:' + url : url}
              target={key === 'email' ? undefined : '_blank'}
              rel="noopener noreferrer"
              aria-label={`${friend.name} · ${labels[key] ?? key}`}
              title={labels[key] ?? key}
            >
              {Icon ? <Icon aria-hidden="true" /> : <span>{labels[key] ?? key}</span>}
            </a>
          )
        })
      }
    </div>
  </div>
</article>
<script>
  document.querySelectorAll<HTMLImageElement>('[data-friend-avatar]').forEach((img) => {
    const hide = () => {
      img.hidden = true
    }
    img.addEventListener('error', hide, { once: true })
    if (img.complete && !img.naturalWidth) hide()
  })
</script>
