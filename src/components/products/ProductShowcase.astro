---
import type { ImageMetadata } from 'astro'
import ProductLayout from './ProductLayout.astro'

interface Screenshot {
  src: ImageMetadata
  alt: string
  caption?: string
}

interface Props {
  theme: 'bdfun' | 'overtone'
  name: string
  wordmark?: string
  headline: string
  description: string
  icon: string
  repository: string
  hero: Screenshot[]
  features?: {
    label: string
    title: string
    description: string
    screenshot: Screenshot
    wide?: boolean
  }[]
  downloads: { title: string; description: string; href: string; action: string }[]
  credits: string
  upstream?: { label: string; href: string }
}

const {
  theme,
  name,
  wordmark,
  headline,
  description,
  icon,
  repository,
  hero,
  features = [],
  downloads,
  credits,
  upstream,
} = Astro.props
---

<ProductLayout
  name={name}
  title={headline}
  description={description}
  icon={icon}
  image={hero[0].src.src}
>
  <slot name="head" slot="head" />
  <div class:list={['product', theme]}>
    <header class="site-nav">
      <div class="wrap nav-inner">
        <a class="brand" href="#main">
          <img src={icon} alt="" width="30" height="30" />
          {name}
        </a>
        <nav aria-label="官网导航">
          <a href="#features">功能</a>
          {
            Astro.slots.has('faq') && (
              <a class="wide-nav" href="#faq">
                常见问题
              </a>
            )
          }
          <a href={repository}>GitHub</a>
          <a class="button nav-download" href="#download">下载</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="art">
          {
            wordmark && (
              <span class="backdrop-word" aria-hidden="true">
                {wordmark}
              </span>
            )
          }
          <div class="devices">
            {
              hero.map((shot, index) => (
                <div class:list={['device', `device-${index + 1}`]}>
                  <img
                    src={shot.src.src}
                    width={shot.src.width}
                    height={shot.src.height}
                    alt={shot.alt}
                    fetchpriority={index === 0 ? 'high' : undefined}
                    decoding="async"
                  />
                </div>
              ))
            }
          </div>
        </div>
        <div class="wrap hero-copy">
          <div>
            <h1 id="hero-title">{headline}</h1>
            <p>{description}</p>
          </div>
          <a class="button primary" href="#download">下载 {name}</a>
        </div>
      </section>

      <slot name="features">
        <section class="wrap features" id="features" aria-label={`${name} 的功能`}>
          {
            features.map(({ label, title, description: detail, screenshot, wide }) => (
              <article class:list={['feature', { 'feature-wide': wide }]}>
                <div class="feature-copy">
                  <p class="feature-label">{label}</p>
                  <h2>{title}</h2>
                  <p>{detail}</p>
                </div>
                <figure>
                  <div class="feature-device">
                    <img
                      src={screenshot.src.src}
                      width={screenshot.src.width}
                      height={screenshot.src.height}
                      alt={screenshot.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  {screenshot.caption && <figcaption>{screenshot.caption}</figcaption>}
                </figure>
              </article>
            ))
          }
        </section>
      </slot>

      <section class="download" id="download" aria-labelledby="download-title">
        <div class="wrap download-inner">
          <div class="download-intro">
            <img src={icon} alt="" width="68" height="68" loading="lazy" />
            <h2 id="download-title">下载 {name}</h2>
          </div>
          <div class="release-list">
            {
              downloads.map((download) => (
                <article class="release">
                  <div>
                    <h3>{download.title}</h3>
                    <p>{download.description}</p>
                  </div>
                  <a class="button release-button" href={download.href}>
                    {download.action}
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>
      <slot name="faq" />
    </main>

    <footer class="wrap footer">
      <p>{credits}</p>
      <nav aria-label="项目链接">
        <a href="/app">所有应用</a>
        <a href={repository}>源代码</a>
        {upstream && <a href={upstream.href}>{upstream.label}</a>}
      </nav>
    </footer>
  </div>
</ProductLayout>

<style>
  .product {
    --nav-height: 63px;
    --foreground: #211821;
    --muted: #695c69;
    --paper: #fff9fc;
    --accent: #ff8db8;
    --accent-ink: #360c20;
    --panel: #faeaf3;
    --stage: #130c17;
    --glow: #85416e;
    background: var(--paper);
    color: var(--foreground);
  }
  .overtone {
    --foreground: #141414;
    --muted: #595959;
    --paper: #fff;
    --accent: #fff;
    --accent-ink: #000;
    --panel: #f4f4f4;
    --stage: #000;
    font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', system-ui, sans-serif;
  }
  .wrap {
    width: min(1240px, calc(100% - clamp(36px, 8vw, 120px)));
    margin-inline: auto;
  }
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    color: #fff;
    background: color-mix(in srgb, var(--stage) 91%, transparent);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid #fff2;
  }
  .nav-inner,
  .site-nav nav,
  .brand {
    display: flex;
    align-items: center;
  }
  .nav-inner {
    min-height: calc(var(--nav-height) - 1px);
    justify-content: space-between;
    gap: 14px;
  }
  .brand {
    gap: 10px;
    font-size: 1.15rem;
    font-weight: 800;
    text-decoration: none;
  }
  .brand img,
  .download-intro img {
    border-radius: 24%;
  }
  .bdfun .brand img,
  .bdfun .download-intro img {
    border-radius: 0;
  }
  .site-nav nav {
    gap: clamp(10px, 3vw, 30px);
    font-size: 0.875rem;
    font-weight: 650;
  }
  .site-nav nav a:not(.button) {
    text-decoration: none;
  }
  .site-nav nav a:not(.button):hover {
    text-decoration: underline;
  }
  .button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 44px;
    border-radius: 999px;
    padding: 10px 21px;
    font-weight: 800;
    line-height: 1.3;
    text-decoration: none;
    transition: filter 150ms ease;
  }
  .button:hover {
    filter: brightness(0.88);
  }
  .nav-download {
    background: #fff;
    color: var(--stage);
    min-height: 36px;
    padding: 8px 16px;
  }
  .hero {
    color: #fff;
    background: var(--stage);
  }
  .bdfun .hero {
    display: grid;
    min-height: calc(100svh - var(--nav-height));
    grid-template-rows: minmax(64px, 1fr) auto;
  }
  .overtone .hero {
    display: grid;
    min-height: calc(100svh - var(--nav-height));
    grid-template-rows: minmax(116px, 1fr) auto;
  }
  .art {
    position: relative;
    display: grid;
    place-items: end center;
    min-height: clamp(335px, 44vw, 620px);
    overflow: clip;
    isolation: isolate;
    background: radial-gradient(ellipse at 50% 83%, var(--glow), transparent 68%);
  }
  .backdrop-word {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: start center;
    color: #fff;
    opacity: 0.1;
    font-size: clamp(68px, 20vw, 300px);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.085em;
    user-select: none;
    pointer-events: none;
  }
  .bdfun .art {
    min-height: 0;
    place-items: center;
    container-type: size;
    background: radial-gradient(ellipse 60% 43% at 50% 54%, var(--glow), transparent);
  }
  .overtone .art {
    min-height: 0;
    place-items: center;
    container-type: size;
    background: none;
  }
  .bdfun .backdrop-word {
    inset-block-start: clamp(6px, 4cqh, 24px);
    font-size: min(22vw, 43cqh, 290px);
  }
  .devices {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 42px 0 0;
    transform: translateY(22px);
    width: 100%;
  }
  .device img {
    width: 100%;
  }
  .bdfun .devices {
    --phone-width: min(34vw, 320px, calc((100cqh - 12px) * 0.43));
    align-items: center;
    padding: 0;
    transform: none;
  }
  .bdfun .device {
    flex: 0 0 var(--phone-width);
    filter: drop-shadow(0 17px 24px #08050d9c);
  }
  .bdfun .device-1 {
    order: 1;
    z-index: 1;
  }
  .bdfun .device-2 {
    order: 0;
    margin-inline-end: calc(var(--phone-width) * -0.1);
    transform: translate(5%, 6%) rotate(-9deg) scale(0.9);
  }
  .bdfun .device-3 {
    order: 2;
    margin-inline-start: calc(var(--phone-width) * -0.1);
    transform: translate(-5%, 6%) rotate(9deg) scale(0.9);
  }
  .overtone .devices {
    --device-gap: clamp(8px, 1.6vw, 24px);
    display: grid;
    /* Match the 8.6", 11", and 6.3" screen diagonals within the original PNG canvases. */
    grid-template-columns: minmax(0, 0.825fr) minmax(0, 1fr) minmax(0, 0.319fr);
    align-items: end;
    gap: var(--device-gap);
    width: min(92%, 1380px, max(140px, calc((100cqh - 24px) * 2.95)));
    padding: 0;
    transform: none;
  }
  .overtone .device-1,
  .overtone .device-3 {
    z-index: 1;
  }
  .overtone .device-1 {
    translate: 10% 3%;
  }
  .overtone .device-3 {
    translate: -22% 5%;
  }
  .hero-copy {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 20px 40px;
    align-items: end;
    padding-block: clamp(42px, 6vw, 78px);
  }
  .bdfun .hero-copy {
    gap: clamp(10px, 2svh, 20px) 30px;
    padding-block: clamp(8px, 2.4svh, 24px) clamp(14px, 4svh, 36px);
  }
  .overtone .hero-copy {
    padding-block: clamp(12px, 2vw, 24px) clamp(34px, 4vw, 48px);
  }
  h1,
  h2 {
    line-height: 1.14;
    letter-spacing: -0.052em;
    text-wrap: balance;
  }
  h1 {
    font-size: clamp(2.45rem, 6vw, 5.75rem);
    font-weight: 800;
  }
  .bdfun h1 {
    font-size: clamp(2rem, min(8.4vw, 7svh), 4.75rem);
  }
  .overtone h1 {
    font-size: clamp(2.45rem, 5.5vw, 4.75rem);
  }
  .hero-copy p {
    max-width: 44rem;
    color: #ffffffc9;
    margin-top: 15px;
    font-size: clamp(1rem, 1.5vw, 1.22rem);
  }
  .bdfun .hero-copy p {
    margin-top: 8px;
  }
  .primary {
    flex: none;
    min-height: 50px;
    background: var(--accent);
    color: var(--accent-ink);
  }
  .features {
    padding-block: clamp(55px, 9vw, 130px);
    display: grid;
    gap: 22px;
  }
  .feature {
    min-height: 475px;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: clamp(16px, 4.5vw, 68px);
    padding: clamp(24px, 5vw, 66px);
    border-radius: clamp(20px, 4vw, 46px);
    background: var(--panel);
  }
  .feature:nth-child(even) .feature-copy {
    order: 1;
  }
  .feature-label {
    font-size: 0.875rem;
    font-weight: 800;
    margin-bottom: 12px;
    color: var(--muted);
  }
  .feature h2,
  .download h2 {
    font-size: clamp(2rem, 4.8vw, 4.75rem);
    font-weight: 800;
  }
  .feature-copy > p:last-child {
    margin-top: 18px;
    max-width: 29rem;
    color: var(--muted);
  }
  .feature-device {
    width: min(100%, 248px);
    margin-inline: auto;
    border-radius: 23px;
    overflow: hidden;
    border: 3px solid #221e28;
    box-shadow: 0 12px 30px #2114272a;
  }
  .feature-wide .feature-device {
    width: 100%;
    border-radius: 14px;
  }
  .bdfun .feature-device {
    border: 0;
    box-shadow: none;
  }
  .overtone .feature:not(.feature-wide) img {
    width: 107%;
    max-width: none;
    margin: -16% -3.5% 0;
  }
  .feature figure figcaption {
    color: var(--muted);
    text-align: center;
    margin-top: 12px;
    font-size: 0.875rem;
  }
  .download {
    background: var(--panel);
    padding-block: clamp(44px, 8vw, 105px);
  }
  .download-inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: start;
    gap: 30px 50px;
  }
  .download-intro img {
    margin-bottom: 16px;
  }
  .release-list {
    display: grid;
    gap: 10px;
  }
  .release {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: clamp(16px, 2.6vw, 28px);
    border-radius: 20px;
    background: var(--paper);
  }
  .release h3 {
    font-size: 1.2rem;
  }
  .release p {
    color: var(--muted);
    max-width: 34rem;
    margin-top: 3px;
  }
  .release-button {
    flex: none;
    color: #fff;
    background: var(--stage);
  }
  .bdfun .download {
    background: #f5f2f4;
  }
  .bdfun .download-inner {
    grid-template-columns: 1fr;
    max-width: 720px;
  }
  .bdfun .download-intro {
    text-align: center;
  }
  .bdfun .download-intro img {
    margin-inline: auto;
  }
  .footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px 35px;
    padding-block: 36px;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .footer p {
    max-width: 47rem;
  }
  .footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
  }
  @media (max-width: 710px) {
    .wide-nav {
      display: none;
    }
    .art {
      min-height: 345px;
    }
    .hero-copy {
      align-items: flex-start;
      flex-direction: column;
    }
    .feature,
    .download-inner {
      grid-template-columns: 1fr;
    }
    .feature {
      min-height: 0;
    }
    .feature:nth-child(even) .feature-copy {
      order: initial;
    }
  }
  @media (max-width: 710px) and (min-height: 500px) {
    .overtone .devices {
      grid-template-columns: minmax(0, 0.825fr) minmax(0, 0.319fr);
      width: min(93%, 500px, max(145px, calc((100cqh - 16px) * 0.81)));
    }
    .overtone .device-2 {
      grid-column: 1 / -1;
      grid-row: 1;
      justify-self: center;
      width: calc((100% - var(--device-gap)) / 1.144);
    }
    .overtone .device-1,
    .overtone .device-3 {
      translate: 0 -8%;
    }
  }
  @media (min-width: 711px), (max-height: 480px) {
    .bdfun .backdrop-word {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
  }
</style>
