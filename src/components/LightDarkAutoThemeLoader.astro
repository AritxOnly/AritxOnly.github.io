<script is:inline>
  ;(() => {
    const root = document.documentElement
    const light = root.dataset.lightTheme
    const dark = root.dataset.darkTheme
    const hash = root.dataset.themeHash
    const fallback = root.dataset.theme || 'auto'
    const media = window.matchMedia('(prefers-color-scheme: dark)')
    let preference = fallback
    try {
      const stored = localStorage.getItem('data-theme')
      if (
        localStorage.getItem('data-theme-hash') === hash &&
        [light, dark, 'auto'].includes(stored)
      )
        preference = stored
      localStorage.setItem('data-theme', preference)
      localStorage.setItem('data-theme-hash', hash)
    } catch {}
    const apply = () => {
      root.dataset.theme =
        preference === 'auto' ? (media.matches ? dark : light) : preference
    }
    apply()
    media.addEventListener('change', () => {
      try {
        preference = localStorage.getItem('data-theme') || preference
      } catch {}
      if (preference === 'auto') apply()
    })
    window.addEventListener('site-theme-preference', (event) => {
      preference = event.detail
      apply()
    })
  })()
</script>
