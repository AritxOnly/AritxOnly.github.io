---
import Layout from '~/layouts/Layout.astro'
import SectionIntro from '~/components/SectionIntro.astro'
import data from '~/data/music.json'
const dateLabel = (date?: string) =>
  date
    ?.split('-')
    .filter((part) => part !== 'xx')
    .join('.') ?? ''
---

<Layout title="音乐作品" description="Aritx 音唯的原创与混音作品。戴上耳机，换个频道。">
  <SectionIntro
    label="音乐作品"
    title="代码先放一边，戴上耳机。"
    description="旋律系 Bass 乐爱好者的存档：有原创，也有 Remix。希望其中某一段旋律，刚好能陪你一会儿。"
    ><a class="md-button tonal" href="https://music.163.com/#/artist?id=34279798"
      >去网易云找我 ↗</a
    ></SectionIntro
  >
  {
    data.upcoming.length > 0 && (
      <section>
        <>
          <h2 class="section-heading">还在路上的新歌</h2>
          <div class="music-grid">
            {data.upcoming.map((track: any) => (
              <a
                class="track-card"
                href={track.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                <img src={track.cover} alt={track.title} loading="lazy" />
                <h3>{track.title}</h3>
              </a>
            ))}
          </div>
        </>
      </section>
    )
  }
  <section>
    <div class="section-top">
      <div><p class="eyebrow">按下播放</p><h2>我的唱片架</h2></div><span class="muted"
        >{data.recent.length} 首作品</span>
    </div><div class="music-grid">
      {
        data.recent.map((track) => (
          <a
            class="track-card"
            href={track.link}
            target="_blank"
            rel="noopener noreferrer"
          >
            <>
              <div class="track-cover">
                <>
                  <img src={track.cover} alt={`${track.title}封面`} loading="lazy" />
                  <span aria-hidden="true">↗</span>
                </>
              </div>
              <h3>{track.title}</h3>
              <p>{dateLabel(track.release_date)} · 在网易云收听</p>
            </>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
