---
import Layout from '~/layouts/Layout.astro'
import SectionIntro from '~/components/SectionIntro.astro'
import ProjectShowcase from '~/components/ProjectShowcase.astro'
import apps from '~/data/apps.json'
---

<Layout title="应用与项目" description="音唯折腾过的应用、音乐工具和开源项目。">
  <SectionIntro
    label="应用与项目"
    title="自己想用，就动手做了。"
    description="从待办日历、影音和赛车，到系统定制与配乐工具。"
  />
  <section class="app-section" aria-labelledby="featured-projects">
    <h2 class="sr-only" id="featured-projects">主要项目</h2>
    <ProjectShowcase illustrated />
  </section>
  <section class="app-section" aria-labelledby="secondary-projects">
    <h2 class="sr-only" id="secondary-projects">副项目</h2>
    <div class="secondary-grid">
      {
        apps.secondary.map((app) => (
          <a
            class="secondary-project"
            id={app.id}
            href={app.repository}
            aria-labelledby={`${app.id}-title`}
            aria-describedby={`${app.id}-description`}
          >
            <div>
              <h3 id={`${app.id}-title`}>{app.name}</h3>
              <p id={`${app.id}-description`}>{app.description}</p>
            </div>
            <span class="secondary-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))
      }
    </div>
  </section>
  <div class="page-note">
    还有一些实验和课程项目，放在 <a href="https://github.com/AritxOnly">GitHub ↗</a
    >。欢迎翻翻，也欢迎提 Issue。
  </div>
</Layout>

<style>
  .app-section + .app-section {
    margin-top: clamp(24px, 3vw, 36px);
  }
  .secondary-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .secondary-project {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    border-radius: 20px;
    background: var(--md-surface-container-low);
    color: var(--md-on-surface);
  }
  .secondary-project:hover,
  .secondary-project:focus-visible {
    background: var(--md-surface-container);
  }
  .secondary-project:focus-visible {
    outline: 2px solid var(--md-primary);
    outline-offset: 2px;
  }
  .secondary-project h3 {
    font-family: var(--font-ui);
    font-size: 17px;
    font-weight: 700;
  }
  .secondary-project p {
    margin-top: 4px;
    color: var(--md-on-surface-variant);
    font-size: 14px;
    line-height: 1.65;
  }
  .secondary-arrow {
    flex: none;
    align-self: flex-start;
    color: var(--md-primary);
    font-size: 18px;
  }
  @media (max-width: 640px) {
    .secondary-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
