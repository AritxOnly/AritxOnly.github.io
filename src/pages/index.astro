---
import Layout from '~/layouts/Layout.astro'
import StoryView from '~/components/StoryView.astro'
import { getSortedPosts } from '~/utils'
import { getCollection, render } from 'astro:content'
import PostPreview from '~/components/PostPreview.astro'
import ProfileAvatar from '~/components/ProfileAvatar.astro'
import GitHubActivityCalendar from '~/components/GitHubActivityCalendar.astro'
import TagsSection from '~/components/TagsSection.astro'
import SeriesSection from '~/components/SeriesSection.astro'
import ProjectShowcase from '~/components/ProjectShowcase.astro'
import { Image } from 'astro:assets'
import deadlinerPoster from '~/assets/deadliner/home-poster.png'
const home = (await getCollection('home'))[0]
const HomeContent = home ? (await render(home)).Content : undefined
const posts = await getSortedPosts()
const latest = [...posts].reverse().slice(0, 3)
---

<Layout>
  <StoryView>
    <section class="intro" aria-labelledby="intro-title">
      <div class="intro-copy">
        <img
          class="banner-logo"
          src="/logo-trimmed.webp"
          alt="Aritx 原创 Logo"
          width="1121"
          height="428"
        />
        <p class="eyebrow"><span class="status-dot"></span> ARITX ZHOU · 个人小站</p>
        <h1 id="intro-title">
          嗨，我是<span>音唯。</span>
        </h1>
        <p class="intro-line">写点代码，做点音乐。<br />偶尔也来这里碎碎念。</p>
        <p class="intro-note">
          欢迎来串门！开发笔记、做过的小工具，还有一些舍不得删的日常，都放在这里了。
        </p>
        <div class="intro-actions">
          <a class="md-button filled" href="#writing"
            >读读博客 <span aria-hidden="true">↗</span></a
          ><a class="md-button tonal" href="/about"
            >认识一下 <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
      <div class="portrait-panel">
        <span class="portrait-caption">HELLO, WORLD.</span>
        <div class="avatar-orbit">
          <ProfileAvatar /><span class="orbit-star" aria-hidden="true">✦</span>
        </div>
        <div class="portrait-bottom">
          <span>AritxOnly<br /><small>开发者 / 音乐创作者</small></span><a
            href="https://github.com/AritxOnly"
            class="round-link"
            aria-label="访问 AritxOnly 的 GitHub">↗</a
          >
        </div>
        <span class="portrait-tag tag-code">&lt; / &gt; Code</span><span
          class="portrait-tag tag-music">♫ Music</span
        >
      </div>
    </section>
  </StoryView>
  <div class="interest-strip" aria-label="我的兴趣">
    <span>这个人兴趣有点多。</span><div>
      <span>软件开发</span><span>电子音乐</span><span>生活切片</span><span
        class="strip-star"
        aria-hidden="true">✳</span
      >
    </div>
  </div>
  {
    latest.length > 0 && (
      <section id="writing" class="home-section">
        <div class="section-top">
          <>
            <div>
              <>
                <p class="eyebrow">随手记一笔</p>
                <h2>最近在写</h2>
              </>
            </div>
            <a class="text-link" href="/posts">
              所有文章 <span aria-hidden="true">↗</span>
            </a>
          </>
        </div>
        <div class="journal-list">
          {latest.map((post) => (
            <PostPreview post={post} />
          ))}
        </div>
      </section>
    )
  }
  <section class="home-section" aria-labelledby="projects-title">
    <div class="section-top">
      <div>
        <p class="eyebrow">我的工具箱</p><h2 id="projects-title">一些折腾的成果</h2>
      </div><a class="text-link" href="/app">更多项目 ↗</a>
    </div>
    <ProjectShowcase featured />
  </section>
  <section class="about-section home-section" aria-labelledby="about-title">
    <div>
      <p class="eyebrow">关掉编辑器以后</p><h2 id="about-title">也不总是在写代码。</h2><a
        class="text-link"
        href="/music">听听我的音乐 ↗</a
      ><div class="sound-wave" aria-hidden="true">
        {
          [24, 46, 68, 38, 85, 110, 65, 40, 76, 98, 56, 32, 68, 42, 20].map((height) => (
            <i style={`height:${height}px`} />
          ))
        }
      </div>
    </div>
    <div class="about-copy prose">{HomeContent && <HomeContent />}</div>
  </section>
  <a class="journey-link" href="/about#journey"
    ><span
      >从南大校园，到第一份实习。<small>这些年都在忙些什么？来翻翻我的时间轴。</small
      ></span
    ><span aria-hidden="true">↗</span></a
  >
  <div class="explore-grid">
    {
      posts.some((post) => post.data.series) && (
        <section>
          <>
            <p class="eyebrow">连起来看</p>
            <h2>沿着一个话题</h2>
            <SeriesSection posts={posts} />
          </>
        </section>
      )
    }
    {
      posts.some((post) => post.data.tags?.length) && (
        <section>
          <>
            <p class="eyebrow">挑个感兴趣的</p>
            <h2>随兴趣逛逛</h2>
            <TagsSection posts={posts} />
          </>
        </section>
      )
    }
  </div>
  {
    home?.data.githubCalendar && (
      <section class="activity-section home-section">
        <>
          <div class="section-top">
            <>
              <div>
                <>
                  <p class="eyebrow">今天也敲了几行</p>
                  <h2>持续构建中</h2>
                </>
              </div>
              <a class="text-link" href="https://github.com/AritxOnly">
                GitHub ↗
              </a>
            </>
          </div>
          <GitHubActivityCalendar username={home.data.githubCalendar} />
        </>
      </section>
    )
  }
</Layout>
