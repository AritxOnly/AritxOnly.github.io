---
import Layout from '~/layouts/Layout.astro'
import SectionIntro from '~/components/SectionIntro.astro'
import FriendCard from '~/components/FriendCard.astro'
import friends from '~/data/friends.json'
const sorted = [...friends].sort(
  (a, b) =>
    (b.priority ?? 0) - (a.priority ?? 0) ||
    Number(b.reciprocal ?? false) - Number(a.reciprocal ?? false) ||
    a.name.localeCompare(b.name, 'zh-Hans-CN'),
)
---

<Layout title="朋友们" description="互联网很大，能互相串门的小站很珍贵。">
  <SectionIntro
    label="朋友们"
    title="来都来了，再串个门？"
    description="有一起写代码的伙伴，也有生活里的老朋友。每个头像后面，都是一个有趣的人。"
  />
  <div class="friends-grid">{sorted.map((friend) => <FriendCard friend={friend} />)}</div>
  <section class="exchange-panel">
    <div>
      <p class="eyebrow">给你留个位置</p><h2>交换一下友链吧。</h2><p>
        原创内容为主、网站能稳定打开就好，写什么都欢迎。带上你的小站名字、链接、头像和一句介绍，给我发封邮件吧。也欢迎把我加进你的友链，RSS
        链接可以一起带上。
      </p>
    </div><a
      class="md-button filled"
      href="mailto:aritxonly@outlook.com?subject=来交换友链吧">敲敲邮箱 ↗</a>
  </section>
</Layout>
