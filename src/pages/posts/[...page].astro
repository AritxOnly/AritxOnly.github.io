---
import type { GetStaticPaths } from 'astro'
import Layout from '~/layouts/Layout.astro'
import { getSortedPosts } from '~/utils'
import Pagination from '~/components/Pagination.astro'
import siteConfig from '~/site.config'
import PostPreview from '~/components/PostPreview.astro'
import SectionIntro from '~/components/SectionIntro.astro'

// Note: Pagination like '/', '/2', '/3' only works with spread param like [...page]
export const getStaticPaths = (async ({ paginate }) => {
  const sortedPosts = await getSortedPosts()
  return paginate(sortedPosts.reverse(), { pageSize: siteConfig.pageSize })
}) satisfies GetStaticPaths

const { page } = Astro.props
const pageTitle = '博客' + (page.currentPage > 1 ? ` - Page ${page.currentPage}` : '')
---

<Layout title={pageTitle} description="开发笔记、生活切片，还有一些想到就写的碎碎念。">
  <div class="blog-archive">
    <div class="archive-intro">
      <SectionIntro
        label="博客 / FIELD NOTES"
        title="想到了，就记下来。"
        description="踩过的坑，听过的歌，偶尔较真的一些小事。欢迎随便翻翻。"
      />
      <div class="archive-stamp" aria-label={`共 ${page.total} 篇文章`}>
        <strong>{String(page.total).padStart(2, '0')}</strong><span>篇随手记</span>
      </div>
    </div>
    <div class="journal-list">{page.data.map((post) => <PostPreview post={post} />)}</div>
    <Pagination
      prevLink={page.url.prev ? page.url.prev : undefined}
      prevText="更新的帖子"
      nextLink={page.url.next ? page.url.next : undefined}
      nextText="以前的帖子"
    />
  </div>
</Layout>
